{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packetcraft.dev/schemas/content-registry-v1.json",
  "title": "packetcraft.dev content registry snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "source", "revision", "items"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "const": "full"
    },
    "source": {
      "const": "portfolio-site"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,64}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "kind", "status", "comments_enabled"],
      "properties": {
        "slug": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "maxLength": 50,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "status": {
          "enum": ["draft", "published", "archived"]
        },
        "comments_enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
