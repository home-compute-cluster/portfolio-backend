# Local API configuration. Copy this file to .env and keep .env uncommitted.
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Local development reaches the existing CNPG read-write Service through the
# developer-managed 127.0.0.1:15432 port-forward. Replace only the non-secret
# example values as needed; never commit a real password.
DATABASE_URL=postgres://portfolio:password@127.0.0.1:15432/portfolio?sslmode=require
DB_MAX_CONNS=5
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=5s
DB_READINESS_TIMEOUT=750ms
